VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# Optional licensed raster XYZ tile CDN. Set both values, then rebuild.
# Keep these blank to use the existing OpenStreetMap street tiles.
VITE_STREET_TILES_URL=
VITE_STREET_TILES_ATTRIBUTION=
VITE_SITE_URL=# Public origin of the site, no trailing slash (e.g. https://example.co.ke). Used for link-share previews.
# Laravel Reverb, for live chat. Leave the key blank and chat falls back to polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
